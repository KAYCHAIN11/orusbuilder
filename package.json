{
  "name": "orus-builder",
  "version": "1.0.0",
  "description": "Gerador cognitivo open source de aplicações React, Express e Prisma orientado por Product Blueprint.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OrusMind/Orus-Builder-FullStack.git"
  },
  "bugs": {
    "url": "https://github.com/OrusMind/Orus-Builder-FullStack/issues"
  },
  "homepage": "https://github.com/OrusMind/Orus-Builder-FullStack#readme",
  "keywords": [
    "ai-code-generation",
    "application-builder",
    "open-source",
    "react",
    "typescript"
  ],
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "infra:up": "docker compose up -d mongodb",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f mongodb",
    "infra:status": "docker compose ps",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "test": "npm test --workspace=backend",
    "test:frontend": "npm test --workspace=frontend",
    "test:e2e:generator": "npm run test:e2e:generator --workspace=backend --",
    "test:e2e:browser": "npm run test:e2e:browser --workspace=backend",
    "test:e2e:isolation": "npm run test:e2e:isolation --workspace=backend",
    "type-check": "npm run type-check --workspace=frontend && npm run type-check --workspace=backend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend",
    "verify": "npm run verify:distribution && npm run lint && npm run type-check && npm run test:data-recovery && npm run test && npm run test:frontend && npm run build",
    "verify:distribution": "node scripts/validate-distribution.mjs",
    "verify:e2e": "npm run test:e2e:generator --workspace=backend -- tests/e2e/generator-build.e2e.ts -t generates.*certifies.*downloads --silent",
    "data:backup": "node scripts/production-data.mjs backup",
    "data:restore": "node scripts/production-data.mjs restore",
    "test:data-recovery": "node scripts/production-data.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "cosmiconfig": {
      "yaml": "1.10.3"
    },
    "file-stream-rotator": {
      "moment": "2.31.0"
    }
  },
  "dependencies": {
    "prismjs": "^1.30.0"
  },
  "allowScripts": {
    "bcrypt": true,
    "@swc/core": true,
    "esbuild": true,
    "es5-ext@0.10.64": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "jsdom": "^30.1.2"
  }
}
