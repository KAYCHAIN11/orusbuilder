{
  "name": "orus-builder-backend",
  "version": "1.0.0",
  "description": "ORUS Builder - Cognitive Code Generation Platform (Backend)",
  "main": "dist/server.js",
  "author": "Minerva Omega + Tulio (ORUS Creator)",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e:generator": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:browser": "vitest run --config vitest.e2e.config.mts tests/e2e/generated-browser.e2e.ts",
    "test:e2e:isolation": "vitest run --config vitest.e2e.config.mts tests/e2e/container-isolation.e2e.ts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cheerio": "^0.22.35",
    "@playwright/test": "^1.64.0",
    "@xmldom/xmldom": "^0.8.15",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "groq-sdk": "1.6.0",
    "helmet": "^7.2.0",
    "http": "^0.0.1-security",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "marked": "^11.1.0",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "redis": "^4.6.12",
    "socket.io": "^4.8.4",
    "typescript": "^5.9.3",
    "uuid": "^13.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.20",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "10.12.0",
    "supertest": "^6.3.3",
    "tsx": "^4.23.15",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
