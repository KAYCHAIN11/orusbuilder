{
  "name": "lumenacademy-api",
  "version": "1.0.0",
  "description": "Backend API generated by ORUS Builder",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "db:setup": "node scripts/setup-database.js",
    "predev": "npm run db:setup",
    "prestart": "npm run db:setup",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "cors": "^2.8.5",
    "helmet": "^7.2.0",
    "express-rate-limit": "^8.1.0",
    "dotenv": "^16.6.1",
    "bcryptjs": "^3.0.2",
    "zod": "^3.25.76",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.12.0",
    "@prisma/client": "6.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/supertest": "^6.0.2",
    "@types/jest": "^29.5.11",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0"
  }
}