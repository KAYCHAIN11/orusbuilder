 
# ═══════════════════════════════════════════════════════════════
# ORUS BUILDER - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════

# Application
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/orus-builder
MONGODB_USER=
MONGODB_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=your-session-secret-change-in-production

# AI Providers
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Trinity Integration (Future)
TRINITY_ENABLED=false
TRINITY_ENDPOINT=
TRINITY_API_KEY=

# CIG-2.0 Protocol
CIG_VALIDATION_ENABLED=true
CIG_STRICT_MODE=true
CIG_MAX_COMPILATION_TIME=30000
CIG_MIN_TYPE_COVERAGE=95
CIG_MAX_COMPLEXITY=15

# Logging
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs

# Security
CORS_ORIGIN=http://localhost:3000
ENCRYPTION_KEY=your-encryption-key-with-at-least-32-characters
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Durable Local State
ORUS_JOB_STORE_PATH=.orus-data/generation-jobs.json
ORUS_PROJECT_STORE_FILE=.orus-data/projects.json
ORUS_BLUEPRINT_STORE_FILE=.orus-data/blueprints.json
ORUS_USER_STORE_FILE=.orus-data/users.json
ORUS_COLLABORATION_STORE_FILE=.orus-data/collaboration.json
ORUS_LEARNING_STORE_FILE=.orus-data/learning.json
ORUS_GENERATION_RETENTION_HOURS=168
ORUS_MAX_CONCURRENT_GENERATIONS=2
ORUS_MAX_QUEUED_GENERATIONS=20
ORUS_MAX_QUEUE_WAIT_MS=300000
ORUS_SLO_QUEUE_WAIT_P95_MS=60000
ORUS_SLO_GENERATION_SUCCESS_RATE=0.95
ORUS_EXECUTION_ISOLATION=process
ORUS_EXECUTION_IMAGE=node:20-bookworm-slim
ORUS_PREVIEW_BROWSER_GATE=true
ORUS_BROWSER_EXECUTABLE=
ORUS_ENABLE_LEGACY_COLLABORATION_ENGINE=false
ORUS_ENABLE_DEPLOYMENT_ENGINE=false
ORUS_ENABLE_MARKETPLACE_ENGINE=false
ORUS_ENABLE_ENTERPRISE_ENGINE=false
ORUS_ENABLE_TEST_ROUTES=false

# Performance
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=30000

# Multilingual
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,pt_BR,es
