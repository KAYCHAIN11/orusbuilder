NODE_ENV=production
PORT=5000
API_VERSION=v1
FRONTEND_URL=https://builder.example.com
CORS_ORIGIN=https://builder.example.com

MONGODB_URI=mongodb://user:password@mongodb:27017/orus-builder
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
SESSION_SECRET=replace-with-another-unique-secret-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-unique-encryption-key-of-at-least-32-characters

AI_PROVIDER=groq
GROQ_API_KEY=replace-with-provider-key
GROQ_MODEL=llama-3.3-70b-versatile

CIG_VALIDATION_ENABLED=true
CIG_STRICT_MODE=true

ORUS_EXECUTION_ISOLATION=container-required
ORUS_EXECUTION_IMAGE=node:20-bookworm-slim
ORUS_PREVIEW_BROWSER_GATE=true
ORUS_JOB_STORE_PATH=/var/lib/orus/generation-jobs.json
ORUS_PROJECT_STORE_FILE=/var/lib/orus/projects.json
ORUS_BLUEPRINT_STORE_FILE=/var/lib/orus/blueprints.json
ORUS_USER_STORE_FILE=/var/lib/orus/users.json
ORUS_COLLABORATION_STORE_FILE=/var/lib/orus/collaboration.json
ORUS_LEARNING_STORE_FILE=/var/lib/orus/learning.json
ORUS_GENERATION_RETENTION_HOURS=168
ORUS_MAX_CONCURRENT_GENERATIONS=2
ORUS_MAX_QUEUED_GENERATIONS=20
ORUS_ENABLE_TEST_ROUTES=false
ORUS_ENABLE_LEGACY_COLLABORATION_ENGINE=false
ORUS_ENABLE_DEPLOYMENT_ENGINE=false
ORUS_ENABLE_MARKETPLACE_ENGINE=false
ORUS_ENABLE_ENTERPRISE_ENGINE=false

LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/orus
